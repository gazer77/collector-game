@implements IAsyncDisposable
@inject GameSession Session
@inject IJSRuntime JS
@inject NavigationManager Navigation

@switch (Session.Status)
{
    case SessionStatus.Loading:
        <div class="splash"><p class="splash-text">Opening the farm gate…</p></div>
        break;

    case SessionStatus.Failed:
        <div class="splash">
            <p class="splash-text">@Session.FailureMessage</p>
            <button class="btn btn-primary" @onclick="Reload">Reload</button>
        </div>
        break;

    default:
        var defs = Session.Definitions;
        var state = Session.State;
        <div class="game">
            <TopBar State="state" />

            <main class="map-area">
                @if (_placing is not null || _moving is not null)
                {
                    <div class="placing-banner" role="status">
                        <span>
                            Tap where the @(_placing is not null ? defs.Producers[_placing].Name : defs.Producers[state.FindPlacement(_moving!.Value)?.Producer ?? ""].Name) should go.
                        </span>
                        <button class="btn btn-quiet" @onclick="CancelPlacing">Cancel</button>
                    </div>
                }
                <FarmMap State="state"
                         SelectedId="_selected"
                         PlacingProducer="@(_placing ?? MovingProducer)"
                         OnTapPlacement="TapPlacement"
                         OnTapCell="TapCell" />
            </main>

            <aside class="sheet" aria-label="Farm panels">
                @if (_selected is { } id && state.FindPlacement(id) is not null)
                {
                    <ProducerPanel State="state" PlacementId="id" OnClose="() => _selected = null" OnMove="StartMove" />
                }
                else
                {
                    <nav class="tabs" role="tablist">
                        @foreach (var (tab, label) in Tabs)
                        {
                            var badge = tab == Tab.Orders ? FillableOrders(state) : 0;
                            <button role="tab" class="tab @(tab == _tab ? "is-active" : "")" aria-selected="@(tab == _tab)" @onclick="() => _tab = tab">
                                @label
                                @if (badge > 0)
                                {
                                    <span class="tab-badge" aria-hidden="true">@badge</span>
                                    <span class="visually-hidden">, @badge ready to deliver</span>
                                }
                            </button>
                        }
                    </nav>
                    <div class="sheet-body">
                        @switch (_tab)
                        {
                            case Tab.Orders: <OrdersPanel State="state" />break;
                            case Tab.Storage: <StoragePanel State="state" />break;
                            case Tab.Market: <MarketPanel State="state" />break;
                            case Tab.Shop: <ShopPanel State="state" OnBuild="StartPlacing" />break;
                        }
                    </div>
                }
            </aside>

            <Toasts />
        </div>
        break;
}

@code {
    [Parameter, EditorRequired] public string PackId { get; set; } = "";

    private enum Tab { Orders, Storage, Market, Shop }
    private static readonly (Tab, string)[] Tabs = [(Tab.Orders, "Orders"), (Tab.Storage, "Storage"), (Tab.Market, "Market"), (Tab.Shop, "Build")];

    private Tab _tab = Tab.Orders;
    private int? _selected;
    private string? _placing;
    private int? _moving;
    private DotNetObjectReference<GameApp>? _self;
    private IJSObjectReference? _hotkeys;

    private string? MovingProducer => _moving is { } id ? Session.State.FindPlacement(id)?.Producer : null;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.StartAsync(PackId);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private static int FillableOrders(PlayerState state) =>
        state.Orders.Count(slot => slot.Order is { } order && order.Items.All(kv => state.Count(kv.Key) >= kv.Value));

    private void TapPlacement(int placementId)
    {
        var placement = Session.State.FindPlacement(placementId);
        if (placement is null)
            return;
        // Tapping something with finished goods collects them straight away, like picking up a basket.
        if (placement.Jobs.Any(j => j.IsReady(Session.State.Time)))
            Session.Do(new Collect(placementId));
        _selected = placementId;
    }

    private void TapCell((int X, int Y) cell)
    {
        if (_placing is { } producer)
        {
            if (Session.Do(new PlaceProducer(producer, cell.X, cell.Y)).Ok)
                _placing = null;
        }
        else if (_moving is { } id)
        {
            if (Session.Do(new MoveProducer(id, cell.X, cell.Y)).Ok)
                _moving = null;
        }
    }

    private void StartPlacing(string producerId)
    {
        _placing = producerId;
        _moving = null;
        _selected = null;
    }

    private void StartMove(int placementId)
    {
        _moving = placementId;
        _placing = null;
        _selected = null;
    }

    private void CancelPlacing()
    {
        _placing = null;
        _moving = null;
    }

    private void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _self = DotNetObjectReference.Create(this);
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Collector.UI/hotkeys.js");
        _hotkeys = await module.InvokeAsync<IJSObjectReference>("register", _self);
        await module.DisposeAsync();
    }

    [JSInvokable]
    public void OnHotkey(string key)
    {
        if (Session.Status != SessionStatus.Ready)
            return;
        // R works anywhere; recipe keys belong to the selected producer, so the same key can differ between producers.
        if (key == "r")
            Session.Replant(_selected);
        else if (_selected is { } id && Session.State.FindPlacement(id) is { } placement
                 && Session.Definitions.RecipesFor(placement.Producer).FirstOrDefault(r => r.Hotkey == key) is { } recipe)
            Session.StartOn(placement.Id, recipe.Id);
    }

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnChanged;
        try
        {
            if (_hotkeys is not null)
            {
                await _hotkeys.InvokeVoidAsync("dispose");
                await _hotkeys.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
