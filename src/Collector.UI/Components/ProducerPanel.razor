@inject GameSession Session

@{
    var defs = Session.Definitions;
    var engine = Session.Engine;
    var placement = State.FindPlacement(PlacementId)!;
    var producer = defs.Producers[placement.Producer];
    var slots = engine.SlotsOf(placement);
    var lanes = engine.LanesOf(placement);
    var now = State.Time;
    var ready = placement.Jobs.Count(j => j.IsReady(now));
    var speedUpCost = engine.SpeedUpCost(State, placement);
    var freeSlots = slots - placement.Jobs.Count;
    var group = engine.GatherGroup(State, placement);
    var groupReady = group.Sum(p => p.Jobs.Count(j => j.IsReady(now)));
    var canAuto = engine.CanAutoRestart(State, placement);
    var unlocked = defs.RecipesFor(producer.Id).Where(r => State.Level >= r.UnlockLevel).ToList();
}
<section class="panel" aria-labelledby="producer-title">
    <header class="panel-head">
        <span class="panel-glyph" aria-hidden="true">@defs.Emoji(producer.Asset)</span>
        <div>
            <h2 id="producer-title" class="panel-title">@producer.Name</h2>
            <p class="panel-sub">
                @(lanes == slots ? "Everything runs at once" : lanes == 1 ? "One at a time" : $"{lanes} at a time")
                · @placement.Jobs.Count of @slots slots in use
                @if (canAuto)
                {
                    <text> · @(placement.Paused ? "Paused" : "Runs by itself")</text>
                }
            </p>
        </div>
        <button class="btn btn-quiet close" @onclick="OnClose" aria-label="Close">✕</button>
    </header>

    @if (placement.Jobs.Count > 0)
    {
        <ol class="jobs">
            @for (var i = 0; i < placement.Jobs.Count; i++)
            {
                var index = i;
                var job = placement.Jobs[index];
                var recipe = defs.Recipes[job.Recipe];
                var output = recipe.Outputs.First();
                <li class="job @(job.IsReady(now) ? "is-ready" : "")">
                    <span class="job-glyph" aria-hidden="true">@defs.Emoji(defs.Items[output.Key].Asset)</span>
                    <span class="job-name">@output.Value × @defs.Items[output.Key].Name</span>
                    <span class="job-time">
                        @if (job.IsReady(now)) { <text>Ready</text> }
                        else if (job.StartsAt > now) { <text>Waiting · @Display.Duration(job.EndsAt - job.StartsAt)</text> }
                        else { @Display.Duration(job.EndsAt - now) }
                    </span>
                    @if (job.StartsAt > now)
                    {
                        <button class="btn btn-quiet btn-small" @onclick="() => Session.Do(new CancelJob(placement.Id, index))"
                                title="Cancel and get the ingredients back">Cancel</button>
                    }
                </li>
            }
        </ol>
    }
    @if (groupReady > 0 || speedUpCost is not null)
    {
        <div class="actions">
            @if (groupReady > ready)
            {
                <button class="btn btn-primary" @onclick="() => Session.Do(new Collect(placement.Id))">Collect all @groupReady</button>
            }
            else if (ready > 0)
            {
                <button class="btn btn-primary" @onclick="() => Session.Do(new Collect(placement.Id))">Collect @ready</button>
            }
            @if (speedUpCost is { } cost && defs.Manifest.SpeedUp is { } speedUp)
            {
                <button class="btn" @onclick="() => Session.Do(new SpeedUp(placement.Id))">
                    Finish now <span class="cost"><span aria-hidden="true">@defs.Emoji(defs.Currencies[speedUp.Currency].Asset)</span>@cost</span>
                </button>
            }
        </div>
    }

    @if (canAuto)
    {
        <div class="auto-box @(placement.Paused ? "is-paused" : "")">
            <div class="auto-head">
                <span class="auto-state">@(placement.Paused ? "Paused: finished goods wait for you" : "Collects and starts batches by itself")</span>
                <button class="btn btn-small" @onclick="() => Session.Do(new PauseProducer(placement.Id, !placement.Paused))">
                    @(placement.Paused ? "Resume" : "Pause")
                </button>
            </div>
            @if (unlocked.Count > 1)
            {
                <p class="auto-note">
                    @(placement.Plan.Count > 0 ? "Makes these in turn, skipping any it's short of. Tap a step to remove it."
                      : placement.LastRecipe is { } last ? $"Repeats {RecipeName(defs.Recipes[last])}. Add steps to make several things in turn."
                      : "Add steps for it to make in turn, or start something and it repeats it.")
                </p>
                @if (placement.Plan.Count > 0)
                {
                    <ol class="plan" aria-label="Schedule">
                        @for (var i = 0; i < placement.Plan.Count; i++)
                        {
                            var index = i;
                            var step = defs.Recipes[placement.Plan[index]];
                            var isNext = index == (placement.PlanLast + 1) % placement.Plan.Count;
                            <li>
                                <button class="plan-step @(isNext ? "is-next" : "")" title="Remove from the schedule"
                                        @onclick="() => Session.Do(new SetPlan(placement.Id, placement.Plan.Where((_, j) => j != index).ToList()))">
                                    <span aria-hidden="true">@defs.Emoji(defs.Items[step.Outputs.Keys.First()].Asset)</span>
                                    @RecipeName(step)
                                    @if (isNext) { <span class="visually-hidden">(next)</span> }
                                    <span class="plan-remove" aria-hidden="true">✕</span>
                                </button>
                            </li>
                        }
                    </ol>
                }
                <div class="plan-add">
                    <span class="plan-add-label">Add</span>
                    @foreach (var recipe in unlocked)
                    {
                        <button class="btn btn-small btn-quiet" disabled="@(placement.Plan.Count >= Collector.Engine.Simulation.GameEngine.MaxPlanLength)"
                                @onclick="() => Session.Do(new SetPlan(placement.Id, [.. placement.Plan, recipe.Id]))">
                            <span aria-hidden="true">@defs.Emoji(defs.Items[recipe.Outputs.Keys.First()].Asset)</span>@RecipeName(recipe)
                        </button>
                    }
                    @if (placement.Plan.Count > 0)
                    {
                        <button class="btn btn-small btn-quiet" @onclick="() => Session.Do(new SetPlan(placement.Id, []))">Clear</button>
                    }
                </div>
            }
        </div>
    }

    <h3 class="panel-heading">@(producer.Category == "field" ? "Plant" : "Make")</h3>
    <ul class="recipes">
        @foreach (var recipe in defs.RecipesFor(producer.Id))
        {
            var output = recipe.Outputs.First();
            var locked = State.Level < recipe.UnlockLevel;
            var missing = recipe.Inputs.Any(i => State.Count(i.Key) < i.Value);
            <li class="recipe @(locked ? "is-locked" : "")">
                <span class="recipe-glyph" aria-hidden="true">@defs.Emoji(defs.Items[output.Key].Asset)</span>
                <div class="recipe-body">
                    <span class="recipe-name">@(string.IsNullOrEmpty(recipe.Name) ? defs.Items[output.Key].Name : recipe.Name)@if (recipe.Hotkey is { } hotkey) { <kbd class="hotkey" title="Press @hotkey.ToUpperInvariant() while this is selected to start it here">@hotkey.ToUpperInvariant()</kbd> }</span>
                    <span class="recipe-detail">
                        @foreach (var input in recipe.Inputs)
                        {
                            <span class="need @(State.Count(input.Key) < input.Value ? "is-short" : "")">
                                <span aria-hidden="true">@defs.Emoji(defs.Items[input.Key].Asset)</span>@State.Count(input.Key)/@input.Value
                                <span class="visually-hidden">@defs.Items[input.Key].Name</span>
                            </span>
                        }
                        <span class="recipe-time">@Display.Duration(engine.DurationOf(State, placement, recipe))</span>
                    </span>
                    @if (Session.OrderDemand(output.Key) is > 0 and var wanted)
                    {
                        var have = State.Count(output.Key);
                        <span class="recipe-demand @(have >= wanted ? "is-met" : "")">Orders want @wanted · have @have</span>
                    }
                </div>
                @if (locked)
                {
                    <span class="locked-note">Level @recipe.UnlockLevel</span>
                }
                else if (missing && Session.CostOfMissing(recipe.Inputs) is { } buyCost && Session.BuyCurrency is { } currency)
                {
                    <button class="btn" disabled="@(State.Balance(currency.Id) < buyCost)" @onclick="() => Session.BuyMissing(recipe.Inputs)"
                            title="Buy what's missing from the market">
                        Buy <span class="cost"><span aria-hidden="true">@defs.Emoji(currency.Asset)</span>@buyCost.ToString("N0")</span>
                    </button>
                }
                else
                {
                    <button class="btn" disabled="@(missing || freeSlots <= 0)" title="@(producer.Category == "field" ? "Press R to replant the next empty field with its last crop" : null)" @onclick="() => Session.Do(new StartRecipe(placement.Id, recipe.Id))">
                        @(producer.Category == "field" ? "Plant" : "Start")
                    </button>
                }
            </li>
        }
    </ul>

    <h3 class="panel-heading">Upgrades</h3>
    <ul class="shop">
        @foreach (var (track, label, current, glyph) in new[]
        {
            (UpgradeTrack.Slots, "Slots", slots, "📥"),
            (UpgradeTrack.Lanes, "At once", lanes, "⏩"),
        })
        {
            var next = engine.NextTier(placement, track);
            <li class="shop-row @(next is not null && State.Level < next.UnlockLevel ? "is-locked" : "")">
                <span class="stock-glyph" aria-hidden="true">@glyph</span>
                <div class="shop-body">
                    <span class="shop-name">@label: @current@(next is not null ? $" → {next.Count}" : "")</span>
                    <span class="shop-detail">@(track == UpgradeTrack.Slots ? "How many batches you can line up" : "How many run at the same time")</span>
                </div>
                @if (next is null)
                {
                    <span class="owned-note">Maxed</span>
                }
                else if (State.Level < next.UnlockLevel)
                {
                    <span class="locked-note">Level @next.UnlockLevel</span>
                }
                else
                {
                    <button class="btn btn-small" @onclick="() => Session.Do(new UpgradeProducer(placement.Id, track))">
                        Buy
                        @foreach (var line in defs.Lines(next.Cost))
                        {
                            <span class="cost"><span aria-hidden="true">@defs.Emoji(line.Asset)</span>@line.Amount.ToString("N0")</span>
                        }
                    </button>
                }
            </li>
        }
    </ul>

    @if (defs.UpgradesFor(producer.Id).ToList() is { Count: > 0 } upgrades)
    {
        <h3 class="panel-heading">Equipment</h3>
        <ul class="shop">
            @foreach (var upgrade in upgrades)
            {
                <UpgradeRow State="State" Upgrade="upgrade" />
            }
        </ul>
    }

    <div class="actions actions-secondary">
        <button class="btn btn-quiet" @onclick="() => OnMove.InvokeAsync(placement.Id)">Move</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public PlayerState State { get; set; } = null!;
    [Parameter, EditorRequired] public int PlacementId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnMove { get; set; }

    private string RecipeName(RecipeDefinition recipe) =>
        string.IsNullOrEmpty(recipe.Name) ? Session.Definitions.Items[recipe.Outputs.Keys.First()].Name : recipe.Name;
}
