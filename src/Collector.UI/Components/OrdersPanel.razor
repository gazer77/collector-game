@inject GameSession Session

@{
    var defs = Session.Definitions;
    var assistant = Session.HasHelper(h => h.FillsOrders);
}
<section class="panel" aria-label="Orders">
    @if (defs.Orders is null || State.Orders.Count == 0)
    {
        <p class="empty">Orders open up at level @(defs.Orders?.UnlockLevel ?? 1).</p>
    }
    else
    {
        <p class="panel-intro">
            Customers pay more than the market. Deliver an order to earn coins and XP.
            @if (Session.HasHelper(h => h.FillsOrders))
            {
                <text> Your assistant delivers any order you have the goods for, leaving the amounts you keep in Storage.</text>
            }
        </p>
        <ul class="orders">
            @for (var i = 0; i < State.Orders.Count; i++)
            {
                var slot = i;
                var order = State.Orders[slot].Order;
                if (order is null)
                {
                    <li class="order is-empty">New order in @Display.Duration(State.Orders[slot].AvailableAt - State.Time)</li>
                    continue;
                }
                var canFill = order.Items.All(kv => State.Count(kv.Key) >= kv.Value);
                var buyCost = canFill ? null : Session.CostOfMissing(order.Items);
                // Goods the assistant won't hand over because the player keeps them.
                var held = assistant && canFill ? order.Items.Where(kv => State.Count(kv.Key) - kv.Value < State.Keep(kv.Key)).Select(kv => kv.Key).ToList() : [];
                <li class="order @(canFill ? "is-fillable" : "")">
                    <div class="order-items">
                        @foreach (var (item, qty) in order.Items)
                        {
                            <span class="need @(State.Count(item) < qty ? "is-short" : "")">
                                <span class="need-glyph" aria-hidden="true">@defs.Emoji(defs.Items[item].Asset)</span>
                                @State.Count(item)/@qty
                                <span class="visually-hidden">@defs.Items[item].Name</span>
                            </span>
                        }
                    </div>
                    <div class="order-reward">
                        @foreach (var (currency, amount) in order.Rewards)
                        {
                            <span class="cost"><span aria-hidden="true">@defs.Emoji(defs.Currencies[currency].Asset)</span>@amount.ToString("N0")</span>
                        }
                        <span class="xp">+@order.Xp XP</span>
                    </div>
                    @if (held.Count > 0)
                    {
                        <p class="order-note">Your assistant is holding back: you keep @string.Join(", ", held.Select(i => $"{State.Keep(i)} {defs.Items[i].Name}")).</p>
                    }
                    <div class="order-actions">
                        @if (buyCost is { } cost && Session.BuyCurrency is { } buyCurrency)
                        {
                            <button class="btn" disabled="@(State.Balance(buyCurrency.Id) < cost)" @onclick="() => Session.BuyMissing(order.Items)"
                                    title="Buy what's missing from the market, then deliver">
                                Buy missing <span class="cost"><span aria-hidden="true">@defs.Emoji(buyCurrency.Asset)</span>@cost.ToString("N0")</span>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary" disabled="@(!canFill)" @onclick="() => Session.Do(new FillOrder(slot))">Deliver</button>
                        }
                        <button class="btn btn-quiet" @onclick="() => Session.Do(new DiscardOrder(slot))" title="A new order arrives after @Display.Duration(defs.Orders.DiscardCooldownSeconds * 1000)">Skip</button>
                    </div>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public PlayerState State { get; set; } = null!;
}
