@inject GameSession Session

@{
    var defs = Session.Definitions;
    var land = defs.Land;
    var now = State.Time;
}
<div class="map-scroll">
    <div class="map" style="width:@(land.Width * Cell)px;height:@(land.Height * Cell)px;--cell:@(Cell)px">
        @foreach (var parcel in land.Parcels)
        {
            var owned = State.OwnedParcels.Contains(parcel.Id);
            <div class="parcel @(owned ? "is-owned" : "is-for-sale")" style="@Rect(parcel.X, parcel.Y, parcel.Width, parcel.Height)">
                @if (!owned)
                {
                    <div class="for-sale">
                        @if (State.Level < parcel.UnlockLevel)
                        {
                            <span class="for-sale-note">More land at level @parcel.UnlockLevel</span>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="() => Session.Do(new BuyParcel(parcel.Id))">
                                Buy land
                                @foreach (var line in defs.Lines(parcel.Cost))
                                {
                                    <span class="cost"><span aria-hidden="true">@defs.Emoji(line.Asset)</span>@line.Amount.ToString("N0")</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @foreach (var placement in State.Placements)
        {
            var producer = defs.Producers[placement.Producer];
            var ready = placement.Jobs.Count(j => j.IsReady(now));
            var running = placement.Jobs.FirstOrDefault(j => !j.IsReady(now) && j.StartsAt <= now);
            var isField = producer.Category == "field";
            var free = Session.Engine.TierOf(placement).Slots - placement.Jobs.Count;
            var glyph = isField && placement.Jobs.Count > 0
                ? defs.Emoji(defs.Items[defs.Recipes[placement.Jobs[0].Recipe].Outputs.Keys.First()].Asset)
                : defs.Emoji(producer.Asset);
            <button class="placement cat-@producer.Category @(ready > 0 ? "is-ready" : "") @(placement.Id == SelectedId ? "is-selected" : "") @(isField && placement.Jobs.Count == 0 ? "is-idle" : "")"
                    style="@Rect(placement.X, placement.Y, producer.Width, producer.Height);--tint:@(defs.Tint(producer.Asset) ?? "#9a8a6a")"
                    aria-label="@Label(producer, placement, ready, running, free)"
                    @onclick="() => OnTapPlacement.InvokeAsync(placement.Id)">
                <span class="glyph @(isField && running is not null ? "is-growing" : "")" aria-hidden="true">@glyph</span>
                @if (ready > 0 && !isField)
                {
                    <span class="ready-count" aria-hidden="true">@ready</span>
                }
                @if (free > 0 && !isField)
                {
                    <span class="free-count" aria-hidden="true">@free free</span>
                }
                @if (running is not null)
                {
                    <span class="progress" aria-hidden="true"><span style="width:@Percent(running, now)%"></span></span>
                }
            </button>
        }

        @if (PlacingProducer is { } placingId)
        {
            var placing = defs.Producers[placingId];
            <div class="placing-layer" @onclick="TapLayer" @onmousemove="Hover" @onmouseleave="() => _hover = null">
                @if (_hover is { } h)
                {
                    <div class="ghost" style="@Rect(h.X, h.Y, placing.Width, placing.Height)" aria-hidden="true">@defs.Emoji(placing.Asset)</div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Tile size in CSS pixels.</summary>
    public const int Cell = 52;

    [Parameter, EditorRequired] public PlayerState State { get; set; } = null!;
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public string? PlacingProducer { get; set; }
    [Parameter] public EventCallback<int> OnTapPlacement { get; set; }
    [Parameter] public EventCallback<(int X, int Y)> OnTapCell { get; set; }

    private (int X, int Y)? _hover;

    private static string Rect(int x, int y, int w, int h) =>
        $"left:{x * Cell}px;top:{y * Cell}px;width:{w * Cell}px;height:{h * Cell}px";

    private static (int X, int Y) CellAt(MouseEventArgs e) => ((int)(e.OffsetX / Cell), (int)(e.OffsetY / Cell));

    private void Hover(MouseEventArgs e) => _hover = CellAt(e);

    private Task TapLayer(MouseEventArgs e) => OnTapCell.InvokeAsync(CellAt(e));

    private static string Percent(Job job, long now) =>
        Math.Clamp(100.0 * (now - job.StartsAt) / Math.Max(1, job.EndsAt - job.StartsAt), 0, 100)
            .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private string Label(ProducerDefinition producer, Placement placement, int ready, Job? running, int free)
    {
        var status = ready > 0 ? $"{ready} ready to collect"
            : running is not null ? $"{Session.Definitions.Recipes[running.Recipe].Name}, {Display.Duration(running.EndsAt - State.Time)} left"
            : placement.Jobs.Count > 0 ? "queued" : "idle";
        return free > 0 && placement.Jobs.Count > 0 ? $"{producer.Name}: {status}, {free} free" : $"{producer.Name}: {status}";
    }
}
