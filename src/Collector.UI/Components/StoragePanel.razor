@inject GameSession Session

@{
    var defs = Session.Definitions;
    var engine = Session.Engine;
    var sellCurrency = defs.Market is { } market ? defs.Currencies[market.SellCurrency] : null;
}
<section class="panel" aria-label="Storage">
    @foreach (var storage in defs.Content.Storage)
    {
        var used = engine.StorageUsed(State, storage.Id);
        var capacity = engine.StorageCapacity(State, storage.Id);
        var tier = State.StorageTier(storage.Id);
        var next = tier + 1 < storage.Tiers.Count ? storage.Tiers[tier + 1] : null;
        var items = defs.Content.Items.Where(i => i.Storage == storage.Id && (State.Count(i.Id) > 0 || IsLingering(i.Id))).ToList();
        <div class="store">
            <header class="store-head">
                <span class="panel-glyph" aria-hidden="true">@defs.Emoji(storage.Asset)</span>
                <h2 class="panel-title">@storage.Name</h2>
                <span class="store-fill @(used >= capacity ? "is-full" : "")">@used / @capacity</span>
            </header>
            <span class="capacity" aria-hidden="true"><span style="width:@(Math.Min(100, 100 * used / capacity))%"></span></span>

            @if (items.Count == 0)
            {
                <p class="empty">Empty. Harvest something to fill it.</p>
            }
            else
            {
                <ul class="stock">
                    @foreach (var item in items)
                    {
                        var count = State.Count(item.Id);
                        <li class="stock-row @(count == 0 ? "is-sold-out" : "")">
                            <span class="stock-glyph" aria-hidden="true">@defs.Emoji(item.Asset)</span>
                            <span class="stock-name">@item.Name</span>
                            <span class="stock-count">@count</span>
                            @if (count == 0)
                            {
                                <button class="btn btn-small" disabled>Sold out</button>
                            }
                            else if (sellCurrency is not null && item.SellPrice > 0)
                            {
                                <button class="btn btn-small" @onclick="() => Sell(item.Id)" title="Sell one for @item.SellPrice @sellCurrency.Name">
                                    Sell <span class="cost"><span aria-hidden="true">@defs.Emoji(sellCurrency.Asset)</span>@item.SellPrice</span>
                                </button>
                            }
                        </li>
                    }
                </ul>
            }

            @if (next is not null)
            {
                <button class="btn" disabled="@(State.Level < next.UnlockLevel)" @onclick="() => Session.Do(new UpgradeStorage(storage.Id))">
                    @if (State.Level < next.UnlockLevel)
                    {
                        <text>Expand at level @next.UnlockLevel</text>
                    }
                    else
                    {
                        <text>Expand to @next.Capacity</text>
                        @foreach (var line in defs.Lines(next.Cost))
                        {
                            <span class="cost"><span aria-hidden="true">@defs.Emoji(line.Asset)</span>@line.Amount.ToString("N0")</span>
                        }
                    }
                </button>
            }
        </div>
    }
</section>

@code {
    /// <summary>How long a row stays after its last item is sold, so the list doesn't shift under a quick clicker.</summary>
    private static readonly TimeSpan SoldOutLinger = TimeSpan.FromSeconds(3);

    private readonly Dictionary<string, DateTime> _soldOutAt = [];

    [Parameter, EditorRequired] public PlayerState State { get; set; } = null!;

    private void Sell(string itemId)
    {
        if (Session.Do(new SellItem(itemId, 1)).Ok && Session.State.Count(itemId) == 0)
            _soldOutAt[itemId] = DateTime.UtcNow;
    }

    // The session re-renders every second, which is what eventually drops an expired row.
    private bool IsLingering(string itemId)
    {
        if (!_soldOutAt.TryGetValue(itemId, out var at))
            return false;
        if (DateTime.UtcNow - at < SoldOutLinger)
            return true;
        _soldOutAt.Remove(itemId);
        return false;
    }
}
